[Unit]
Description=Trading 212 Continuous Market & Portfolio Monitor (Human-in-the-Loop)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
Group=YOUR_LINUX_USER
WorkingDirectory=/opt/t212-analyst
EnvironmentFile=/opt/t212-analyst/.env
ExecStart=/opt/t212-analyst/.venv/bin/python /opt/t212-analyst/monitor.py
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/t212-analyst/data

[Install]
WantedBy=multi-user.target

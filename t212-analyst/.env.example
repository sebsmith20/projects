# Trading 212 API Credentials
# Generate in Trading 212 Web App -> Settings -> API
T212_API_KEY=your_trading212_api_key_here
T212_API_SECRET=your_trading212_api_secret_here
# "demo" (paper trading) or "live" (real money). Always test in "demo" first!
T212_ENV=demo

# Monitor Schedule & Market Hours
MONITOR_INTERVAL_MINUTES=15
MARKET_HOURS_ONLY=true
MARKET_TIMEZONE=America/New_York
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=16
MARKET_CLOSE_MINUTE=0

# Analysis Thresholds (cost control: only call LLM when met)
PRICE_MOVE_THRESHOLD_PCT=2.0
DAILY_SUMMARY_HOUR=16
DAILY_SUMMARY_MINUTE=15

# LLM Configuration (OpenAI-compatible endpoint; works with OpenAI, OpenRouter, Ollama, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Notifications (optional webhooks; console output is always enabled)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
DB_PATH=data/t212_analyst.db
WATCHLIST_PATH=watchlist.json
LOG_LEVEL=INFO
